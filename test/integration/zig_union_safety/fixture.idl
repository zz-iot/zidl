// Fixture for the union deinit/error-safety compile-and-run check.
//
// src/backend/zig.zig's union codegen tests only substring-match generated
// text. This fixture is generated for real, compiled, and exercised in
// test.zig so a regression in the generated union `deserializeInto` /
// `deinit` interaction (discriminant committed before the payload is known
// to be valid) is a real `zig build test` failure, not just a missing
// substring.

// `@final` (XCDR2, no DHEADER/EMHEADER framing): the discriminant is read
// unconditionally before the case switch runs.
union FinalStrUnion switch (long) {
    case 0: long i;
    default: string s; // heap-owning case
};

// Mutable default-arm serialization must compile and use the resolved member ID.
@mutable
union MutableStrUnion switch (long) {
    case 0: long i;
    default: string s; // heap-owning default arm
};

// The discriminant's DEFAULT value (0, whatever `defaultForTypeRef` picks
// for `long`) selects the heap-owning case here -- unlike the two unions
// above, where it selects the non-owning `i`/`long` case. Regression for: a
// fresh, never-decoded `.{}` value has `_u = undefined`; if `deserializeInto`
// fails before ANY payload is published (fresh discriminant default still
// in effect), `deinit()` must not follow that default into this owning arm.
union OwningDefaultUnion switch (long) {
    case 0: string s; // owning, AND the discriminant's default value
    case 1: long i;
};

@mutable
union MutableOwningDefaultUnion switch (long) {
    case 0: string s; // owning, AND the discriminant's default value
    case 1: long i;
};

// Default labels need not be last. Their ID follows declaration order, not
// discriminator values or a special default sentinel.
@mutable union DefaultFirst switch (long) {
    default: long fallback;
    case 7: long known;
};

@mutable union ExplicitDefault switch (long) {
    @id(17) case 0: long i;
    @id(99) default: string s;
};

@mutable union SequentialDefault switch (long) {
    @id(17) case 0: long i;
    default: string s;
};

@mutable @autoid(HASH) union HashedDefault switch (long) {
    case 0: long i;
    @hashid("color") default: string s;
};

@mutable union NoDefault switch (long) {
    case 0: long number;
    case 1: string text;
};

union DefaultOwning switch (long) { case 1: long number; default: string text; };
struct Nested { DefaultOwning choices[2]; };
union NestedOwner switch (long) { case 0: Nested value; default: long number; };
union ArrayOwner switch (long) { case 0: DefaultOwning values[2][2]; default: long number; };
struct OptionalOwner { @optional Nested value; };
enum Disc { One, Two };
union EnumOwner switch (Disc) { case One: string text; default: long number; };

typedef boolean BooleanAlias;
union ExhaustiveBool switch(BooleanAlias) { case FALSE: long no; case TRUE: long yes; };

@mutable union GroupedBool switch(boolean) { @id(10) case FALSE: case TRUE: long value; };
@mutable union GroupedBoolOwned switch(boolean) { @id(10) case FALSE: case TRUE: string text; };
@mutable struct StrictPayload { @id(2) string text; @id(3) @optional long extra; };
struct StrictEnvelope { StrictPayload inner; long tail; };
struct StrictFinal { long value; };

struct LiteralDefault { @default("literal") string text; };
struct LiteralPair { @default("first") string first; @default("second") string second; };
struct LiteralEnvelope { LiteralPair inner; long tail; };
@mutable struct LiteralOptional { @default("optional") @optional string text; };
struct LiteralCollision { @default("literal") string text; long _zidl_default_0; };

typedef string LiteralText;
struct LiteralAlias { @default("alias") LiteralText text; };
