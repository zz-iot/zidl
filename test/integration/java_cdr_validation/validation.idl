module JavaValidation {
    @final struct Narrow { @key string text; };
};
module JavaValidation {
    @appendable struct App { @key long value; };
    @appendable struct AppText { @key string text; long tail; };
    @final struct Parent { App inner; long tail; };
    @mutable struct Mut { long value; };
};
module JavaValidation {
    @mutable struct MutText { @key string text; };
    @appendable union AppChoice switch(long) { case 0: long value; };
    @mutable union MutChoice switch(long) { case 0: long value; };
};
