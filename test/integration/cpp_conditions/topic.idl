// Generate the actual typed reader entry points under review.
@appendable struct Topic { @key long id; };

// Builders (--generate-views): written in place in a write loan.
@final struct Frame {
    @key long id;
    string label;
    sequence<float> points;
    sequence<short, 4> few;
    @optional sequence<double> extra;
};

// Compile optional selective readers and getters with and without exceptions.
struct OptionalConditionValue { @optional long number; @optional string text; long tail; };
