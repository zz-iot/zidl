module MapAudit {
    typedef string Key;
    @final struct Numeric { map<long, long, 2> values; long tail; };
    @final struct Owned { map<Key, string, 2> values; long tail; };
    typedef map<Key, string, 2> Inner;
    @final struct Nested { map<long, Inner, 2> values; };
};

module MapAudit {
    struct Holder { map<long, string, 2> a; map<long, string, 2> b; };
    struct Holders { map<long, Holder, 2> values; };
};
