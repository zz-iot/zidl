module Shared {
  @nested struct OtherPosition { long x; long y; };
  @nested struct Position { long x; long y; };
  enum State { IDLE, ACTIVE };
  typedef unsigned long SensorId;
  struct Reading { @key unsigned long id; float temperature; };
};
module ProjectA {
  struct Both { Shared::Position a; Shared::OtherPosition b; };
  struct NonLeading { float before; @key unsigned long id; @key unsigned short channel; };
  struct Vector { long values[2]; };
  // Cover nested walkers directly and through an array typedef dependency.
  struct Matrix { long values[2][3]; @key unsigned long id; };
  struct Cube { long values[2][2][2]; };
  typedef long MatrixValues[2][3];
  struct ArrayAlias { MatrixValues values; };
  struct Packet { Shared::Position position; Shared::State state; Shared::SensorId source; string<12> label; sequence<octet, 8> payload; };
};
