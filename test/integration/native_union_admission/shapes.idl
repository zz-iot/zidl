module Admission {
    @mutable union Value switch(long) {
        @id(10) case 0: long number;
        @id(20) case 1: string text;
        @id(30) default: sequence<string> words;
    };
    @mutable union DefaultFirst switch(long) { @id(40) default: string text; @id(10) case 0: long number; };
    enum Tag { Zero, One };
    @mutable union EnumValue switch(Tag) { @id(10) case Zero: long number; @id(20) default: string text; };
    @mutable union NoDefault switch(long) { @id(10) case 0: long number; };
};
